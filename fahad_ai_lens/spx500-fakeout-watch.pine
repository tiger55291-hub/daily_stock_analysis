//@version=6
indicator("FAHAD SPX500 Fakeout Watch", shorttitle = "FAHAD Fakeout", overlay = true, max_bars_back = 150, max_labels_count = 200)

bool supportedChart = ticker.standard(syminfo.tickerid) == "CAPITALCOM:SPX500" and timeframe.isminutes and timeframe.multiplier == 1 and chart.is_standard
int pivotStrength = 2
int sweepWindowMs = 5 * 60 * 1000

confirmedPivots() =>
    float pivotHigh = ta.pivothigh(high, pivotStrength, pivotStrength)
    float pivotLow = ta.pivotlow(low, pivotStrength, pivotStrength)
    [pivotHigh[1], pivotLow[1], time[pivotStrength + 1]]

[pivotHigh, pivotLow, pivotTime] = request.security(syminfo.tickerid, "5", confirmedPivots(), lookahead = barmerge.lookahead_on)
float rsi = ta.rsi(close, 14)

// Match each reference price to the RSI on the minute that printed it.
referenceRsi(float level, int pivotStart, bool isHigh) =>
    float value = na
    for i = 1 to 120
        if na(time[i]) or time[i] < pivotStart
            break
        if time[i] < pivotStart + 5 * 60 * 1000 and (isHigh ? high[i] : low[i]) == level
            value := rsi[i]
            break
    value

type Sweep
    float level = na
    float reference = na
    float extreme = na
    float extremeRsi = na
    int startedAt = na

method clear(Sweep self) =>
    self.extreme := na
    self.extremeRsi := na
    self.startedAt := na

method startReference(Sweep self, float level, float reference) =>
    self.level := level
    self.reference := reference
    self.clear()

method check(Sweep self, bool isHigh) =>
    float price = isHigh ? high : low
    bool breached = isHigh ? price > self.level : price < self.level
    bool backInside = isHigh ? close < self.level : close > self.level
    bool watch = false
    if not na(self.reference)
        if breached and na(self.startedAt)
            self.startedAt := time
        if not na(self.startedAt)
            if na(self.extreme) or (isHigh ? price > self.extreme : price < self.extreme)
                self.extreme := price
                self.extremeRsi := rsi
            if backInside
                bool diverged = isHigh ? self.extremeRsi < self.reference : self.extremeRsi > self.reference
                watch := diverged and time_close - self.startedAt <= sweepWindowMs
    watch

watchPacket(Sweep sweep, string event) =>
    string packet = '{"schema":"ai-agent-lens/v1","symbol":"CAPITALCOM:SPX500","timeframe":"1"'
    packet += ',"event":"' + event + '","time":"' + str.format_time(time_close, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC") + '"'
    packet += ',"fakeout":{"level":' + str.tostring(sweep.level, format.mintick)
    packet += ',"extreme":' + str.tostring(sweep.extreme, format.mintick)
    packet += ',"close":' + str.tostring(close, format.mintick)
    packet += ',"rsi":' + str.tostring(sweep.extremeRsi, "0.########")
    packet += ',"reference_rsi":' + str.tostring(sweep.reference, "0.########") + '}}'
    packet

var Sweep upper = Sweep.new()
var Sweep lower = Sweep.new()
bool putWatch = false
bool callWatch = false
string alertPacket = ""

if supportedChart and barstate.isconfirmed
    if not na(pivotHigh) and pivotTime != pivotTime[1]
        upper.startReference(pivotHigh, referenceRsi(pivotHigh, pivotTime, true))
    if not na(pivotLow) and pivotTime != pivotTime[1]
        lower.startReference(pivotLow, referenceRsi(pivotLow, pivotTime, false))

    putWatch := upper.check(true)
    callWatch := lower.check(false)
    // A minute that sweeps both sides gives no directional watch.
    if putWatch and callWatch
        putWatch := false
        callWatch := false
    if putWatch
        alertPacket := watchPacket(upper, "SHORT_FAKEOUT_WATCH")
    if callWatch
        alertPacket := watchPacket(lower, "LONG_FAKEOUT_WATCH")

    if close < upper.level
        upper.clear()
    if close > lower.level
        lower.clear()

if alertPacket != ""
    alert(alertPacket, alert.freq_once_per_bar_close)

if putWatch
    label.new(bar_index, high, style = label.style_triangledown, yloc = yloc.abovebar, color = color.red, size = size.tiny)
if callWatch
    label.new(bar_index, low, style = label.style_triangleup, yloc = yloc.belowbar, color = color.lime, size = size.tiny)
